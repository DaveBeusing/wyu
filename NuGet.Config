<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- GROUNDWORK_NUGET_FEED must be set to an externally verified feed path. -->
  <packageSources>
    <clear />
    <add key="groundwork-validated-local" value="%GROUNDWORK_NUGET_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="groundwork-validated-local">
      <package pattern="Groundwork.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
