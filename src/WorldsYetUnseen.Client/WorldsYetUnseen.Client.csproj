<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(WyuInstallerBuild)' == 'true'">WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Compile loop-heavy terrain methods once, before entering their first loop. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WorldsYetUnseen.Client</AssemblyName>
    <RootNamespace>WorldsYetUnseen.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="WorkPackage" Value="WP03" />
    <ProjectReference Include="../WorldsYetUnseen.Gameplay/WorldsYetUnseen.Gameplay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Groundwork.Core" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Diagnostics" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Ecs" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Jobs" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Persistence" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Platform.Windows" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Rendering" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Rendering.D3D12" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Simulation" Version="[0.1.0-dev.43277674049.1]" />
    <PackageReference Include="Groundwork.Voxels" Version="[0.1.0-dev.43277674049.1]" />
  </ItemGroup>
</Project>
