--- /dev/null
+++ b/src/Groundwork.Rendering.D3D12/DrawTiming.cs
@@ -0,0 +1,93 @@
+using TerraFX.Interop.DirectX;
+using static Groundwork.Rendering.D3D12.GpuNative;
+using static TerraFX.Interop.Windows.Windows;
+
+namespace Groundwork.Rendering.D3D12;
+
+internal sealed unsafe partial class GpuDevice
+{
+    private sealed class DrawTiming : IDisposable
+    {
+        internal ID3D12QueryHeap* Heap;
+        internal ID3D12Resource* Data;
+        internal ulong Sequence;
+        internal double CpuMs;
+        internal long Allocated;
+        internal ulong ShadowBytes;
+        internal int ShadowDraws;
+        internal ulong GeometryBuilds;
+        private const uint Slots = 6;
+        private ulong _gpuAnchor, _qpcAnchor, _fence;
+        private bool _calibrated;
+
+        internal void Calibrate(ID3D12CommandQueue* queue, ulong fence)
+        {
+            ulong gpu, qpc;
+            _calibrated = queue->GetClockCalibration(&gpu, &qpc).Value >= 0;
+            _gpuAnchor = gpu;
+            _qpcAnchor = qpc;
+            _fence = fence;
+        }
+
+        internal void Mark(ID3D12GraphicsCommandList* commands, uint index) =>
+            commands->EndQuery(Heap, D3D12_QUERY_TYPE.D3D12_QUERY_TYPE_TIMESTAMP, index);
+
+        internal void Resolve(ID3D12GraphicsCommandList* commands, ulong sequence)
+        {
+            Mark(commands, 5);
+            commands->ResolveQueryData(Heap, D3D12_QUERY_TYPE.D3D12_QUERY_TYPE_TIMESTAMP, 0, Slots, Data, 0);
+            Sequence = sequence;
+        }
+        private readonly ulong _frequency;
+
+        internal DrawTiming(ID3D12Device* device, ID3D12CommandQueue* queue)
+        {
+            ulong frequency;
+            Check(queue->GetTimestampFrequency(&frequency), "Get timestamp frequency");
+            _frequency = frequency;
+            var desc = new D3D12_QUERY_HEAP_DESC { Type = D3D12_QUERY_HEAP_TYPE.D3D12_QUERY_HEAP_TYPE_TIMESTAMP, Count = Slots };
+            fixed (ID3D12QueryHeap** heap = &Heap)
+                Check(device->CreateQueryHeap(&desc, __uuidof<ID3D12QueryHeap>(), (void**)heap), "Create timestamp heap");
+            try
+            {
+                Data = CreateResource(device, D3D12_HEAP_TYPE.D3D12_HEAP_TYPE_READBACK, Buffer(Slots * 8),
+                    D3D12_RESOURCE_STATES.D3D12_RESOURCE_STATE_COPY_DEST);
+            }
+            catch
+            {
+                Release(Heap);
+                throw;
+            }
+        }
+
+        internal void WriteSample()
+        {
+            if (Sequence == 0)
+                return;
+            ulong* values;
+            var range = new D3D12_RANGE { End = Slots * 8 };
+            Check(Data->Map(0, &range, (void**)&values), "Map timestamp data");
+            var frame = (values[5] - values[0]) * 1000d / _frequency;
+            var shadow = (values[2] - values[1]) * 1000d / _frequency;
+            var terrain = (values[4] - values[3]) * 1000d / _frequency;
+            Span<ulong> ticks = stackalloc ulong[(int)Slots];
+            new ReadOnlySpan<ulong>(values, (int)Slots).CopyTo(ticks);
+            range = default;
+            Data->Unmap(0, &range);
+            Console.WriteLine(FormattableString.Invariant(
+                $"WP15 GPU {Sequence},{frame:F6},{shadow:F6},{terrain:F6},{CpuMs:F6},{Allocated},{ShadowBytes},{ShadowDraws},{GeometryBuilds}"));
+            if (_calibrated)
+            {
+                Console.WriteLine(FormattableString.Invariant(
+                    $"WP15 CAL {Environment.ProcessId},{Sequence},{_fence},{_gpuAnchor},{_qpcAnchor},{_frequency},{System.Diagnostics.Stopwatch.Frequency},{ticks[0]},{ticks[1]},{ticks[2]},{ticks[3]},{ticks[4]},{ticks[5]}"));
+            }
+            Sequence = 0;
+        }
+
+        public void Dispose()
+        {
+            Release(Data);
+            Release(Heap);
+        }
+    }
+}
